# AgentForge AI - Environment Variable Template
# Copy this file to `.env` locally and add your private Gemini API key.
# Never commit `.env` or share your real API key in chat.

# Required for Milestone 2: Google Gemini API (official google-genai SDK)
GEMINI_API_KEY=

# Optional: Override the default Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Future milestones: Supabase PostgreSQL + pgvector
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
