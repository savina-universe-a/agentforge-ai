# AgentForge AI - Environment Variable Template
# Copy this file to `.env` locally and add your private credentials.
# Never commit `.env` or share real API keys / connection strings in chat.

# Google Gemini API (official google-genai SDK)
GEMINI_API_KEY=

# Gemini model for AI planning, autonomous agent tool calling, and RAG Q&A
GEMINI_MODEL=gemini-3.5-flash-lite

# Milestone 6: Gemini embeddings & MongoDB Atlas Vector Search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
MONGODB_VECTOR_INDEX_NAME=chunk_embedding_index

# Milestone 5 & 6: MongoDB Atlas persistence and Vector Search (optional — session-only mode if unset)
MONGODB_URI=
MONGODB_DB_NAME=agentforge_ai
